LABSTAR_BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgresql://postgres:senha@localhost:5432/postgres
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-chave-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-somente-no-servidor
LABSTAR_ALLOWED_ORIGINS=http://localhost:5173,http://tauri.localhost,https://tauri.localhost,tauri://localhost
LABSTAR_REQUEST_TIMEOUT_SECONDS=30
LABSTAR_DATABASE_MAX_CONNECTIONS=20
LABSTAR_MAX_FILE_BYTES=52428800
LABSTAR_STORAGE_BUCKET=labstar-files
RUST_LOG=labstar_backend=info,tower_http=info
