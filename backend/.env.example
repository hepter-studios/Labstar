# Endereço local do serviço HTTP.
LABSTAR_BIND_ADDR=127.0.0.1:8080

# Use a conexão PostgreSQL do Supabase com SSL obrigatório.
# Nunca versione a senha real.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# URL pública do projeto Supabase.
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Chave publicável/anon usada somente para validar sessões no Supabase Auth.
# Não use service_role neste serviço.
SUPABASE_PUBLISHABLE_KEY=COLE_A_CHAVE_PUBLICAVEL

# Origens autorizadas, separadas por vírgula.
# Inclua a web oficial, as origens de produção do Tauri e os endereços locais de desenvolvimento.
LABSTAR_ALLOWED_ORIGINS=https://labstar.pages.dev,http://tauri.localhost,https://tauri.localhost,tauri://localhost,http://localhost:5173,http://127.0.0.1:5173

# Limites operacionais.
LABSTAR_REQUEST_TIMEOUT_SECONDS=30
LABSTAR_DATABASE_MAX_CONNECTIONS=10

# Logs estruturados. Não registre tokens, códigos OAuth ou segredos.
RUST_LOG=labstar_backend=info,tower_http=info
